# Dependencies
/node_modules/

# SvelteKit and frontend build output
/.svelte-kit/
/build/
/package/
/dist/
/coverage/

# Rust and Tauri build output
/src-tauri/target/

# Built installers. These live under src-tauri/target/ (already ignored above),
# but the pattern is here too so a DMG copied anywhere for testing or upload can
# never be committed by accident — they are release assets, not repo contents.
*.dmg
/src-tauri/gen/schemas/
**/*.rs.bk

# Generated DMG artwork, from scripts/make-dmg-background.py. Only the TIFF is
# kept: tauri.conf.json reads it, so a fresh clone can bundle without first
# installing rsvg-convert and fonttools — the same reason the generated icons
# under src-tauri/icons/ are committed. Everything else there is an intermediate
# (the SVG, and the two PNGs tiffutil combines) or a preview.
/src-tauri/dmg/*
!/src-tauri/dmg/background.tiff
scripts/__pycache__
# Local application data and temporary files
/tmp/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-wal
*.db-shm

# Environment files and local secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db

# Tool-generated timestamps
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
