# Copy this file to `.env` and put values after `=` with no spaces around it.
# Quotes are optional for these values. Both examples below are valid:
# CROSSREF_MAILTO=researcher@example.com
# CROSSREF_MAILTO="researcher@example.com"
# Restart the app after editing `.env`; startup should report
# `crossref_polite_pool=true` when the email was loaded.

# Optional provider keys for higher, more predictable quotas. Never commit real keys.
# Example: OPENALEX_API_KEY=your_actual_key
OPENALEX_API_KEY=
# Example: SEMANTIC_SCHOLAR_API_KEY=your_actual_key
SEMANTIC_SCHOLAR_API_KEY=

# Recommended. Added as `mailto` to every Crossref request and enables the polite pool.
# Use an email address only, without `mailto:` or angle brackets.
CROSSREF_MAILTO=
